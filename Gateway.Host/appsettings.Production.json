{
  "Gateway": {
    "EnvironmentName": "Production",
    "EnableDetailedErrors": false
  },
  "Auth": {
    "Enabled": true,
    "AllowDevelopmentAnonymous": false,
    "Authority": "",
    "Audience": "",
    "RequireHttpsMetadata": true
  },
  "Security": {
    "ForwardedHeaders": {
      "Enabled": true,
      "KnownProxies": []
    },
    "IpAllowList": {
      "Enabled": false
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  }
}
