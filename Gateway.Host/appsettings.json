{
  "Gateway": {
    "ServiceName": "Gateway.Host",
    "EnvironmentName": "Development",
    "EnableDetailedErrors": true
  },
  "CorrelationId": {
    "HeaderName": "X-Correlation-Id",
    "IncludeInResponse": true
  },
  "Auth": {
    "Enabled": false,
    "AllowDevelopmentAnonymous": false,
    "Authority": "https://login.example.com/",
    "Audience": "gateway-api",
    "RequiredScopes": [ "gateway.access" ],
    "ValidateScopes": true,
    "RequireHttpsMetadata": true,
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true
  },
  "Security": {
    "ForwardedHeaders": {
      "Enabled": false,
      "KnownProxies": []
    },
    "IpAllowList": {
      "Enabled": false,
      "AllowedIps": []
    },
    "RequestSizeLimit": {
      "MaxRequestBodySizeBytes": 1048576
    }
  },
  "RateLimit": {
    "Enabled": true,
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "Resilience": {
    "MaxRetryAttempts": 2,
    "FinancialMaxRetryAttempts": 0,
    "FinancialClusterIds": [ "payments-cluster" ],
    "DisableRetryOnUnsafeHttpMethods": true,
    "RetryDelayMilliseconds": 200,
    "CircuitBreakerSamplingDurationSeconds": 30,
    "CircuitBreakerFailureRatio": 0.5,
    "CircuitBreakerMinimumThroughput": 10,
    "CircuitBreakerBreakDurationSeconds": 15,
    "TotalRequestTimeoutSeconds": 30
  },
  "Cache": {
    "Provider": "Memory",
    "DefaultAbsoluteExpirationSeconds": 300
  },
  "LogMasking": {
    "Enabled": true,
    "MaskToken": "***REDACTED***"
  },
  "InputValidation": {
    "Enabled": true,
    "MaxHeaderLength": 4096
  },
  "HealthChecks": {
    "DownstreamUrls": []
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "accounts-route": {
        "ClusterId": "accounts-cluster",
        "Match": {
          "Path": "/api/v1/accounts/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1/accounts" }
        ]
      },
      "payments-route": {
        "ClusterId": "payments-cluster",
        "Match": {
          "Path": "/api/v1/payments/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1/payments" }
        ]
      }
    },
    "Clusters": {
      "accounts-cluster": {
        "Destinations": {
          "accounts-primary": {
            "Address": "http://localhost:5101/"
          }
        }
      },
      "payments-cluster": {
        "HttpClient": {
          "Name": "gateway-financial"
        },
        "Destinations": {
          "payments-primary": {
            "Address": "http://localhost:5102/"
          }
        }
      }
    }
  },
  "Plugins": {
    "Bank1": {
      "Enabled": true,
      "BaseUrl": "http://localhost:5201/",
      "TimeoutSeconds": 30
    },
    "Bank2": {
      "Enabled": true,
      "BaseUrl": "http://localhost:5202/",
      "TimeoutSeconds": 30
    }
  },
  "AllowedHosts": "*"
}
