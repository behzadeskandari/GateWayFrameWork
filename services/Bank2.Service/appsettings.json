{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Bank2": {
    "ServiceName": "Bank2.Service"
  },
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=bank2.db"
  },
  "AuditDatabase": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=bank2-audit.db"
  },
  "Bank2Proxy": {
    "Enabled": false,
    "BaseUrl": "http://localhost:5102/"
  }
}
